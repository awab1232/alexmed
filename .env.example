# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────
# Postgres connection string (e.g. Supabase pooler URL)
DATABASE_URL=

# ── Queue ─────────────────────────────────────────────
REDIS_URL=
QUEUE_CONCURRENCY=2

# ── Auth ──────────────────────────────────────────────
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Optional: set both to enable "Sign in with Google" on /login and /register.
# https://console.cloud.google.com/apis/credentials — Authorized redirect URI:
# <your-deployed-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Object storage (S3-compatible) ───────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── LLM provider (OpenRouter — supports any model, many free) ───────
# Get a key at https://openrouter.ai/keys. Model is chosen per-request
# (the UI lets the user pick any OpenRouter model), so no default model
# env var is needed here.
OPENROUTER_API_KEY=

# ── Upload limits ─────────────────────────────────────
UPLOAD_MAX_MB=250
