# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────
# Postgres connection string (e.g. Supabase pooler URL)
DATABASE_URL=

# ── Queue ─────────────────────────────────────────────
REDIS_URL=
QUEUE_CONCURRENCY=2

# ── Auth ──────────────────────────────────────────────
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Object storage (S3-compatible) ───────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── LLM provider abstraction ──────────────────────────
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_MODEL_LARGE=gemini-1.5-pro
GEMINI_API_KEY=

# ── Embeddings (future RAG features) ─────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Upload limits ─────────────────────────────────────
UPLOAD_MAX_MB=250
