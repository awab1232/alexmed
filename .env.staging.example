# NiroLearn STAGING — copy to .env.staging (git-ignored) and fill in.
# Every value here must be a STAGING resource; never paste a production value.
# See docs/mobile/ENVIRONMENTS.md.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# New Supabase project (not the production pooler host).
DATABASE_URL=postgresql://USER:PASSWORD@STAGING-HOST:5432/postgres
DATABASE_POOL_MAX=5

# The staging Railway URL — jobs and sign-in redirects go here.
APP_BASE_URL=https://STAGING.up.railway.app
AUTH_URL=https://STAGING.up.railway.app
NEXTAUTH_URL=https://STAGING.up.railway.app
NEXT_PUBLIC_SITE_URL=https://STAGING.up.railway.app

# Fresh secrets (openssl rand -base64 32) — different from production.
AUTH_SECRET=
QUESTION_SET_CODE_HMAC_KEY=
TRUSTED_PROXY_HOPS=1

# Separate Upstash (QStash) for staging.
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QUEUE_MAX_ATTEMPTS=4
QUEUE_GLOBAL_CONCURRENCY=4
QUEUE_PER_USER_CONCURRENCY=2
JOB_CREATION_RATE_LIMIT_MAX=20
JOB_CREATION_RATE_LIMIT_WINDOW_MINUTES=60

# Staging R2 bucket + a token scoped to that bucket only.
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=nirolearn-staging
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_MAX_MB=100

# Staging Google OAuth client (redirect: $AUTH_URL/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (paid): a Vonage sub-account with a low spend cap. Leave empty to
# test with seeded accounts only (phone sign-up then reports "not configured").
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_BRAND=NiroLearn Staging
VONAGE_LOCALE=ar-xa
SMS_MAX_SENDS_PER_HOUR=5

# AI — separate low-limit keys.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
NVIDIA_OCR_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

DOCTOR_SETS_ENABLED=true
BILLING_TIMEZONE=Asia/Amman
